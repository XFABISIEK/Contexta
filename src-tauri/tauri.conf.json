{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleMemory",
  "version": "0.1.0",
  "identifier": "com.simplememory.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimpleMemory",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local memory layer for AI",
    "longDescription": "SimpleMemory is a fast, local knowledge base and central memory layer for AI agents.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
