{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contexta",
  "mainBinaryName": "contexta",
  "version": "0.0.2",
  "identifier": "com.contexta.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Contexta",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local memory layer for AI",
    "longDescription": "Contexta is a fast, local knowledge base and central memory layer for AI agents.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QTBBQzQ0MTA1RTg5QzgKUldUSWlWNFFSS3lnYUZUcVYrT2hIK0FWaVI1Nzg2ZzhMdU43eGlLTWVPMWh1ZXFNc3JzMHMzYUYK",
      "endpoints": ["https://github.com/XFABISIEK/Contexa/releases/latest/download/latest.json"]
    }
  }
}
